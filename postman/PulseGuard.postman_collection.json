    {
      "name": "getMetricSummary",
      "item": [
        {
          "name": "Hourly summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{clientId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/metrics/{{thresholdId}}/summary?from=2026-10-01T00:00:00Z&to=2026-10-01T23:59:59Z&bucket=hour",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics",
                "{{thresholdId}}",
                "summary"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-10-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-10-01T23:59:59Z"
                },
                {
                  "key": "bucket",
                  "value": "hour"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"overall statistics\", () => { pm.expect(b.overall.count).to.eql(5); pm.expect(b.overall.mean).to.eql(42); pm.expect(b.overall.anomalies).to.eql(2); });",
                  "pm.test(\"two hourly buckets\", () => pm.expect(b.buckets.length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown bucket is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{clientId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/metrics/{{thresholdId}}/summary?from=2026-10-01T00:00:00Z&to=2026-10-01T23:59:59Z&bucket=week",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics",
                "{{thresholdId}}",
                "summary"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-10-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-10-01T23:59:59Z"
                },
                {
                  "key": "bucket",
                  "value": "week"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
