                ]
              }
            }
          ]
        },
        {
          "name": "Invalid rule is rejected",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{opsClient}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/metrics/{{latencyId}}/rule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics",
                "{{latencyId}}",
                "rule"
              ]
            },
