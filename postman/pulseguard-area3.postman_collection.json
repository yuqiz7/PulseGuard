{
  "info": {
    "name": "PulseGuard - registration and ingestion (Area 3)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom against a running service (default http://localhost:8080). The first request creates a fresh metric and stores its ID in {{metricId}}."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": "postman-client"
    },
    {
      "key": "otherClientId",
      "value": "postman-other-client"
    },
    {
      "key": "metricId",
      "value": ""
    },
    {
      "key": "metricName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "registerMetric - success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Returns the metric with its ID and effective rule\", () => {",
              "  pm.expect(body.id).to.be.a(\"number\");",
              "  pm.expect(body.name).to.eql(pm.collectionVariables.get(\"metricName\"));",
              "  pm.expect(body.method).to.eql(\"THRESHOLD\");",
              "  pm.expect(body.params.upperBound).to.eql(100);",
              "});",
              "pm.collectionVariables.set(\"metricId\", body.id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"metricName\", \"postman-\" + Date.now());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Client-Id",
            "value": "{{clientId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "metrics"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{metricName}}\",\n  \"unit\": \"ms\",\n  \"method\": \"THRESHOLD\",\n  \"params\": {\n    \"lowerBound\": 0,\n    \"upperBound\": 100\n  },\n  \"warmUpSamples\": 0\n}"
        }
      }
    },
    {
      "name": "registerMetric - EWMA defaults are filled in (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Defaults applied\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.params.alpha).to.eql(0.3);",
              "  pm.expect(body.params.tolerance).to.eql(3);",
              "  pm.expect(body.warmUpSamples).to.eql(10);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Client-Id",
            "value": "{{clientId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
