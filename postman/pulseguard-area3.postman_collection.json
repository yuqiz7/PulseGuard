    {
      "name": "submitDataPoints - batch with one anomaly (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"All points accepted, one anomaly flagged\", () => {",
              "  pm.expect(body.accepted).to.eql(3);",
              "  pm.expect(body.anomalies).to.eql(1);",
              "  pm.expect(body.results.map(r => r.anomaly)).to.eql([false, true, false]);",
              "});"
            ]
          }
        }
      ],
